# Copy this file to .env and replace the example values before starting Compose.
POSTGRES_DB=agriconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-for-db

# Generate a Base64-encoded 32-byte key: openssl rand -base64 32
# Development-only valid 32-byte Base64 key; generate a different value for every real deployment.
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_EXPIRATION=3600000

# Optional. Leave empty while AI_PROVIDER=mock.
AI_API_KEY=

# Public URL embedded in the frontend image during build.
VITE_API_URL=http://localhost:8080
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
RABBITMQ_USERNAME=agriconnect
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
EVENTS_EXCHANGE=agriconnect.events
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75
